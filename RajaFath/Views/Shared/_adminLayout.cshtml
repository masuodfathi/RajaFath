<!-- _AdminLayout.cshtml -->

<!DOCTYPE html>
<html lang="fr" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RajaFath</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@latest/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">


</head>
<body>
    <div class="container-fluid">
        <div class="row min-vh-100">
            <!-- Sidebar -->
            <nav id="sidebar" class="col-md-3 col-lg-2 d-md-block bg-dark sidebar text-light py-4">
                <div class="sidebar-header">
                    <h3>پنل مدیریت</h3>
                </div>
                @* <button type="button" id="sidebarCollapse" class="btn btn-dark">
                    <i class="fas fa-bars"></i>
                </button> *@
                <ul class="list-unstyled components py-4 m-0 px-0">
                    <li class="py-2 ">
                        <a href="/Admin/Dashboard" class="text-decoration-none text-light">داشبورد</a>
                    </li>
                    <li class="py-2">
                        <a href="/Admin/ListRoles" class="text-decoration-none text-light">مدیریت نقشها</a>
                    </li>
                    <li class="py-2">
                        <a href="/Admin/ListUsers" class="text-decoration-none text-light">مدیریت کاربران</a>
                    </li>
                    <li class="py-2">
                        <a href="/Admin/PostList" class="text-decoration-none text-light">نوشته ها</a>
                        <ul class="list-unstyled components py-1 mx-3 px-0">
                            <li class="py-2">
                                <a href="/Admin/PostList" class="text-decoration-none text-light">همه نوشته ها</a>
                            </li>
                            <li class="py-2">
                                <a href="/Admin/CreatePost" class="text-decoration-none text-light">افزودن نوشته</a>
                            </li>
                        </ul>
                    </li>
                    <!-- Add more menu items as needed -->
                </ul>
            </nav>

            <!-- Page Content -->
            <main role="main" class="col-md-9 ml-sm-auto col-lg-10 px-md-4">
                <nav class="navbar navbar-expand-lg navbar-light bg-light">
                    
                    <div class="container-fluid">
                        <!-- Add your header content here -->
                    </div>
                </nav>

                <!-- Main Content -->
                <div class="container">
                    <!-- Content of the admin page goes here -->
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>
    <!-- Add Bootstrap and jQuery scripts (you may need to adjust the paths) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Custom script to toggle the sidebar -->
    <script>
        $(document).ready(function () {
            $('#sidebarCollapse').on('click', function () {
                $('#sidebar').toggleClass('active');
            });
        });
    </script>
</body>
</html>
