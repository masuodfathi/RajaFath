@model List<RajaFath.Models.Managers>
@{
    ViewData["Title"] = "Managers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .fixed-square-image{
        width:200px;
        height:200px;
    }
</style>

<h1 class="text-center my-5 ">اعضای هیئت مدیره</h1>
<div class="container-fluid">
    <div class="row row-cols-1 row-cols-md-4 g-5 align-items-start my-3">
        @foreach(var item in Model)
        {
            <div class="col">
                <a asp-controller="post" asp-action="Show" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                    <img src="@item.Image.ImageUrl" alt="@item.Title" class="fixed-square-image rounded-circle mx-auto d-block object-fit-cover my-round-img" />
                    <h3 class="pt-3 pb-2 text-center">@item.Title</h3>
                    <p class="text-center">@item.Excerpt</p>
                </a>
            </div>
        }
    </div>
</div>
