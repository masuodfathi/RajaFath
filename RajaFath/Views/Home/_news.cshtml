@model List<RajaFath.Models.homePostViewModel>
@{
    ViewData["Title"] = "خبر";
}
<style>
    .line-divider { height: 2px; /* Adjust the height of the line as needed */ background: linear-gradient(to right, transparent 20%, #000, transparent 80%); }
</style>
<hr class="line-divider mt-5 mb-5" />
<div class="container-fluid">
    <h2 class="text-center mb-4">
        آخرین اخبار
    </h2>
    <section class="row row-cols-1 row-cols-lg-4 row-cols-sm-2 g-4">
        @foreach (var item in Model)
        {
            <article class="col">
                <a asp-controller="post" asp-action="show" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                <div class="card h-100">
                    <img src="@item.ImageUrl" class="card-img-top news" alt="@item.Title">
                    <div class="card-body">
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text">@item.Excerpt</p>
                    </div>
                    <div class="card-footer">
                        <small class="text-muted"> @item.TimeDifference قبل</small>
                    </div>
                </div>
                </a>
            </article>
        }
    </section>
</div>