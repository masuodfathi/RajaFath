@model RajaFath.Models.HomePageViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div id="slider">
    <div class="container">
        @if (Model.Carousel != null)
        {
            <partial name="_Carousel" model="Model.Carousel" />
        }
    </div>
</div>
@* company introduction ------------------------------------ *@
<div class="container">
    <div class="row">
        <!-- First Column with h1 and p -->
        <div class="col-md-6">
            <h1>
                معرفی شرکت رجا فتح
            </h1>
            <p>
                فعالیت های ما شامل فعالیت های عمرانی از قبیل طراحی، اجرا، نظارت، احداث مسکن و تولیدی صنعتی شامل تولید کلیه مصالح ساختمانی و قطعات بتونی و بسته بندی مواد غذایی و محصولات کشاورزی و خدمات بازرگانی از قبیل خرید، فروش و شرکت در مزایدهها و مناقصات و ارائه خدمات صادرات واردات مرتبط با فعالیت شرکت، ارائه خدمات آموزشی از قبیل رایانه و بیمه، خدمات بهداشتی و درمانی و حمل و نقل ، خدمات اعتباری و تهیه و توزیع کالاهای مورد نیاز اعضاء.
                </p>
                <p>
همچنین اهم فعاليتها و عملکرد های منتخب شرکت رجاءفتح شامل 1. حوزه مسکن 2. حوزه عمران 3. حوزه صنعت 4. حوزه خدمات 5. حوزه کشاورزی و 5. حوزه تامين و توزیع کالا است.
            </p>
            <p class="text-center">
                <a class="text-start" asp-area="" asp-controller="page" asp-action="show" asp-route-slug="درباره ما">
                    درباره ما بیشتر بدانید
                </a>
            </p>

        </div>
        <!-- Second Column with three rows of divs -->
        <div class="col-md-6 d-flex justify-content-center align-items-center">
            <div class="row my-row">


                <div class=" p-3" id="my-flex">
                    <span class="my-circle">1382</span>
                    سال شروع فعالیت
                </div>


                <div class=" p-3" id="my-flex">
                    <span class="my-circle">12</span>
                    هیئت مدیره شرکت
                </div>


                <div class="p-3" id="my-flex">
                    <span class="my-circle">9</span>
                    پروژه های موفق
                </div>

            </div>

        </div>
    </div>
</div>

@* projects --------------------------------- *@
@if (Model.Projects != null)
{
    <partial name="_homeprojects" model="Model.Projects" />

}
<!----------------------News------------------------->
<partial name="_news" model="Model.News" />

@* Activitis --------------------------------------------*@

@if (Model.Activities != null)
{
    <partial name="_activities" model="Model.Activities" />
}


