@model List<RajaFath.Models.homePostViewModel>
@{
    ViewData["Title"] = "زمینه های فعالیت";
}
<div class="container-fluid border-top mt-4 pt-5">
    <div class="p-4">
        <h2>
            زمینه های فعالیت
        </h2>
    </div>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
            <a asp-action="show" asp-controller="post" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                <div class="image-container">
                    <img src="@item.ImageUrl" alt="@item.Title" class="img-fluid rounded-3 activity">
                    <div class="overlay rounded-3"></div>
                    <div class="overlay-text">
                        @item.Title
                    </div>
                </div>
            </a>
            </div>
        }
        
    </div>
</div>