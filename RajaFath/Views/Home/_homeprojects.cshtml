@model List<RajaFath.Models.Post>
<div class="container">
    <hr />
    <div class="row">
        <div class="p-4">
            <h2 class="text-center mt-3">
                پروژه های فعال
            </h2>
        </div>

    </div>
    <div class="row text-center">
        @foreach (var item in Model)
        {
            <div class="d-flex flex-column justify-content-center align-items-center col-md-4">
                <img src="" alt="" class="rounded-circle mx-auto d-block object-fit-cover my-round-img" />
                <h3 class="pt-3 pb-2">@item.Title</h3>
                <p>@item.Excerpt</p>
            </div>
        }
        
    </div>
</div>