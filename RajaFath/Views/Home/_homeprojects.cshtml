@model List<RajaFath.Models.homePostViewModel>
<div class="container">
    <hr />
    <div class="row">
        <div class="p-4">
            <h2 class="text-center mt-3">
                پروژه های فعال
            </h2>
        </div>

    </div>
    <div class="row text-center align-items-start">
        @foreach (var item in Model)
        {
            <div class="d-flex flex-column justify-content-center align-items-center col-md-4">
                <a asp-controller="Post" asp-action="Show" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                <img src="@item.ImageUrl" alt="@item.Title" class="rounded-circle mx-auto d-block object-fit-cover my-round-img" />
                <h3 class="pt-3 pb-2">@item.Title</h3>
                <p>@item.Excerpt</p>
                </a>
            </div>
        }
        
    </div>
</div>