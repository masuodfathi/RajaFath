@model RajaFath.Models.EditUserViewModel

@{
    ViewData["Title"] = "EditUser";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}

<h2 class="my-4 fw-bolder">
    ویرایش کاربر
</h2>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="EditUser" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />
    
    <div class="form-group m-3">
        <label asp-for="UserName" class="form-label">نام کاربری:</label>
        <input asp-for="UserName" class="form-control" />
        <span asp-validation-for="UserName" class="text-danger"></span>
    </div>

    <div class="form-group m-3">
        <label asp-for="Email" class="form-label">ایمیل:</label>
        <input asp-for="Email" class="form-control" aria-describedby="emailHelp" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group m-3">
        <label asp-for="PhoneNumber" class="form-label">شماره تلفن:</label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <div class="form-group m-3">
        <label for="SelectedRole" class="form-label">نقش:</label>
        <select asp-for="SelectedRole" class="form-select" id="SelectedRole">
            <option value="">نقش را انتخاب کنید ...</option>
            @foreach (var r in Model.AllRoles)
            {
                <option value="@r" selected="@(r == Model.Role)">@r</option>
            }
        </select>
    </div>

    <div class="form-group m-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="ListUsers" class="btn btn-secondary">Cancel</a>
    </div>
</form>

