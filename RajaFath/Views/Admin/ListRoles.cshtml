@model List<Microsoft.AspNetCore.Identity.IdentityRole>
@{
    ViewData["Title"] = "نقش ها";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}



<h1>Roles</h1>
<p>
    <a asp-action="AddRole" class="btn btn-primary">ایجاد نقش</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>نام نقش</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Name</td>
                <td>
                    <a href="@Url.Action("EditRole", new { roleId = role.Id })">Edit</a> |
                    <a href="@Url.Action("DeleteRole", new { roleId = role.Id })">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

