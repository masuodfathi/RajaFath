@model List<UserListViewModel>
@{
    ViewData["Title"] = "ListUsers";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}





<h1>لیست کاربران</h1>
<a asp-action="CreateUser" class="btn btn-primary"><strong class="fw-bold"> + </strong>ایجاد کاربر جدید</a>
<table class="table">
    <thead>
        <tr>
            <th>نام کاربری</th>
            <th>ایمیل</th>
            <th>نقش</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>@user.Role</td>
                <td>
                    <a asp-action="EditUser" asp-route-id="@user.UserId">ویرایش</a> |
                    <a asp-action="DeleteUser" asp-route-id="@user.UserId">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
