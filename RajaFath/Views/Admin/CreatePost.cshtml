@model RajaFath.Models.PostCreateViewModel
@{
    ViewData["Title"] = "CreatePost";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}

<style>
    .custom-file-input {
        position: relative;
        overflow: hidden;
        margin-top: 10px;
        
    }

        .custom-file-input input[type="file"] {
            position: absolute;
            top: 0;
            right: 0;
            margin: 0;
            padding: 0;
            font-size: 20px;
            cursor: pointer;
            opacity: 0;
        }

        .custom-file-input label {
            background-color: #3498db;
            color: white;
            padding: 10px 20px;
            cursor: pointer;
            border-radius: 5px;
        }

        /* Style when a file is selected */
        .custom-file-input input[type="file"]:focus + label,
        .custom-file-input input[type="file"]:valid + label {
            background-color: #e74c3c;
        }
        label.category{
            position:relative;
            width:100%;
            background: #ccced1;
            
        }

    .ck.ck-content.ck-editor__editable.ck-rounded-corners.ck-editor__editable_inline{
        height:70vh;
    }

    div.ck.ck-powered-by{
        display:none;
    }

    #Content{
        display:none;
    }
</style>
<h2>نوشته جدید</h2>

<form asp-action="CreatePost" method="post" enctype="multipart/form-data" id="createpost-form">
    <div class="row">
    <div class="col-md-9">
        <div class="form-group mb-5">
            <label asp-for="Title" class="pb-2">عنوان</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group mb-5">
                <label asp-for="Content" class="pb-2">متن</label>
                <textarea id="Content" asp-for="Content" id="Content" class="ckeditor " name="Content"></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>
        <div class="form-group mb-5">
            <label>خلاصه</label>
            <textarea asp-for="Excerpt"> </textarea>
        </div>
    </div>
    <div class="col-md-3 mt-4">
        <div>
            <label>@Model.CurrentUser?.UserName</label>
            <label>@Model.UpdateDate</label>
                <button type="submit" class="btn btn-primary">انتشار</button>
        </div>
            
            <div class="col mt-2 border rounded ">
                <label class="category rounded-top p-2">دسته بندی:</label>
                <div class="form-group p-3">
                    <input asp-for="SelectedCategoryIds" type="radio" value="" /> دسته بندی نشده
                    <br />
                    @foreach (var category in @Model.AvailableCategories)
                    {
                        <input asp-for="SelectedCategoryIds" type="radio" value="@category.Value" id="category@category.Id" />
                        <label asp-for="SelectedCategoryIds" for="category@category.Id">@category.Text</label>
                        <br />
                    }
                </div>
        </div>
        <hr />
        <div class="col">
                <div class="form-group custom-file-input">
                    <label asp-for="ImageFile" class="pb-2">تصویر شاخص</label>
                    <input asp-for="ImageFile" type="file" class="form-control-file" accept=".jpg, .png" id="featureImage" name="featureImage" />
                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>
                <div id="selectedImageContainer" class="form-group custom-file-input border rounded">
                    <img id="selectedImage" src="#" alt="Selected Feature Image" style="display: none;" width="300" height="200">
                </div>
        </div>
            
    </div>
        
    
    
    </div>
</form>
@* a script for showing feature Image after selection *@
<script>
    // Get references to the input and image elements
    const featureImageInput = document.getElementById('featureImage');
    const selectedImage = document.getElementById('selectedImage');

    // Add an event listener to the input element
    featureImageInput.addEventListener('change', function () {
        const file = this.files[0]; // Get the selected file
        if (file) {
            const reader = new FileReader();

            // Configure the FileReader to display the selected image
            reader.onload = function (e) {
                selectedImage.src = e.target.result;
                selectedImage.style.display = 'block'; // Show the image
            };

            // Read the selected file as a data URL
            reader.readAsDataURL(file);
        } else {
            selectedImage.style.display = 'none'; // Hide the image if no file is selected
        }
    });
</script>

<script src="https://cdn.ckeditor.com/ckeditor5/39.0.2/classic/ckeditor.js"></script>
<script src="https://cdn.ckeditor.com/ckeditor5/39.0.2/classic/translations/fa.js"></script>
<script>
    ClassicEditor
        .create(document.querySelector('#Content'), {
            language:'fa',
            height:'800px'
        })
        .catch(error => {
            console.error(error);
        });
</script>
