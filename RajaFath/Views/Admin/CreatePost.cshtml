@model RajaFath.Models.PostCreateViewModel
@{
    ViewData["Title"] = "CreatePost";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}

<style>
    .custom-file-input {
        position: relative;
        overflow: hidden;
        margin-top: 10px;
        
    }

        .custom-file-input input[type="file"] {
            position: absolute;
            top: 0;
            right: 0;
            margin: 0;
            padding: 0;
            font-size: 20px;
            cursor: pointer;
            opacity: 0;
        }

        .custom-file-input label {
            background-color: #3498db;
            color: white;
            padding: 10px 20px;
            cursor: pointer;
            border-radius: 5px;
        }

        /* Style when a file is selected */
        .custom-file-input input[type="file"]:focus + label,
        .custom-file-input input[type="file"]:valid + label {
            background-color: #e74c3c;
        }
        label.category{
            position:relative;
            width:100%;
            background: #ccced1;
            
        }

    .ck.ck-content.ck-editor__editable.ck-rounded-corners.ck-editor__editable_inline{
        height:70vh;
    }

    div.ck.ck-powered-by{
        display:none;
    }

    #Content{
        display:none;
    }

    .image-grid {
        display: grid;
        justify-content:center;
        align-items:center;
        align-content:center;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        grid-template-rows:repeat(auto-fit,minmax(150px,150px));
        /* Adjust the minmax width as needed */
        grid-gap: 10px;
        /* Adjust the gap between tiles */
    }

    .image-tile {
        position: relative;
        overflow: hidden;
        border: 2px solid transparent;
        width:100%;
        
        /* Add transparent border by default */
    }

    .image-tile img {
        width: 100%;
        
        object-fit:contain;
     }

     .image-tile.selected {
            border-color: blue;
            box-shadow:0 0 0 5px blue;
            /* Add a border color for selected images */
     }

    .image-radio {
        display:none;
    }
</style>
<h2>نوشته جدید</h2>

<form asp-action="CreatePost" method="post" enctype="multipart/form-data" id="createpost-form">
    <div class="row">
    <div class="col-md-9">
        <div class="form-group mb-5">
            <label asp-for="Title" class="pb-2">عنوان</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group mb-5">
                <label asp-for="Content" class="pb-2">متن</label>
                <textarea id="Content" asp-for="Content" id="Content" class="ckeditor " name="Content"></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>
        <div class="form-group mb-5">
            <label>خلاصه</label>
            <textarea asp-for="Excerpt"> </textarea>
        </div>
    </div>
    <div class="col-md-3 mt-4">
        <div>
            <label>@Model.CurrentUser?.UserName</label>
            <label>@Model.UpdateDate</label>
                <button type="submit" class="btn btn-primary">انتشار</button>
        </div>
            
            <div class="col mt-2 border rounded ">
                <label class="category rounded-top p-2">دسته بندی:</label>
                <div class="form-group p-3">
                    <input asp-for="SelectedCategoryIds" type="radio" value="" /> دسته بندی نشده
                    <br />
                    @foreach (var category in @Model.AvailableCategories)
                    {
                        <input asp-for="SelectedCategoryIds" type="radio" value="@category.Value" id="category@category.Id" />
                        <label asp-for="SelectedCategoryIds" for="category@category.Id">@category.Text</label>
                        <br />
                    }
                </div>
        </div>
        <hr />
        <div class="col">

            <!--Modal Button-->
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#myModal">
                    Open Modal
                </button>
                <div class="form-group mb-5">
                    <label asp-for="FeatureImageId" class="pb-2">تصویر شاخص</label>
                    <input type="text" asp-for="FeatureImageId" id="selected-image-id" name="FeatureImageId" />
                    <span asp-validation-for="FeatureImageId" class="text-danger"></span>
                </div>
        </div>
    </div>
    </div>
</form>
<!-- Bootstrap 5 Modal -->
<div class="modal fade" id="myModal">
    <div class="modal-dialog modal-fullscreen p-4">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <h5 class="modal-title">تصویر شاخص</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>

            </div>

            <!-- Modal Body with Tabs -->
            <div class="modal-body">
                <!-- Nav tabs -->
                <ul class="nav nav-tabs" id="myTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active" id="tab1-tab" data-bs-toggle="tab" href="#tab1" role="tab" aria-controls="tab1" aria-selected="true">انتخاب از کتابخانه تصاویر</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" id="tab2-tab" data-bs-toggle="tab" href="#tab2" role="tab" aria-controls="tab2" aria-selected="false">بارگذاری تصویر جدید</a>
                    </li>
                </ul>
                <!-- Tab panes -->
                <div class="tab-content pt-4">
                    <div class="tab-pane fade show active" id="tab1" role="tabpanel" aria-labelledby="tab1-tab">
                        <!-- Content for Tab 1 with scrollable container -->
                        <div class="container overflow-auto m-0">
                            <div class="row">
                                <div class="col-md-9">
                                    <div class="image-grid">
                                        <!-- Add images here dynamically with radio buttons -->
                                        @foreach (var img in Model.Images)
                                        {
                                            <label class="image-tile" data-image-id="@img.Id">
                                                <input type="radio" name="selected-image" class="image-radio">
                                                <img src="@img.ImageUrl" alt="@img.AltText" class="modal-image" width="200" height="200">
                                            </label>
                                        }

                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <p>Display image ditails</p>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="tab-pane fade" id="tab2" role="tabpanel" aria-labelledby="tab2-tab">
                        <!-- Content for Tab 2 with scrollable container -->
                        <div class="container overflow-auto">
                            <div class="row">
                                <div class="col">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary">قرار دادن به عنوان تصویر شاخص</button>
            </div>
        </div>
    </div>
</div>



<script src="https://cdn.ckeditor.com/ckeditor5/39.0.2/classic/ckeditor.js"></script>
<script src="https://cdn.ckeditor.com/ckeditor5/39.0.2/classic/translations/fa.js"></script>

<!--
    CkEditor Script to show it against textarea
-->
<script>
    ClassicEditor
        .create(document.querySelector('#Content'), {
            language:'fa',
            height:'800px'
        })
        .catch(error => {
            console.error(error);
        });
</script>

<!--
     // JavaScript to handle modal image selection
-->
<script src="~/js/JavaScript.js"></script>
