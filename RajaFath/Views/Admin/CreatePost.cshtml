@model RajaFath.Models.PostCreateViewModel
@{
    ViewData["Title"] = "CreatePost";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}
<link rel="stylesheet" href="~/css/CreatePost.css" asp-append-version="true" />
<style>
    .custom-file-input {
        position: relative;
        overflow: hidden;
        margin-top: 10px;
        
    }

        .custom-file-input input[type="file"] {
            position: absolute;
            top: 0;
            right: 0;
            margin: 0;
            padding: 0;
            font-size: 20px;
            cursor: pointer;
            opacity: 0;
        }

        .custom-file-input label {
            background-color: #3498db;
            color: white;
            padding: 10px 20px;
            cursor: pointer;
            border-radius: 5px;
        }

        /* Style when a file is selected */
        .custom-file-input input[type="file"]:focus + label,
        .custom-file-input input[type="file"]:valid + label {
            background-color: #e74c3c;
        }
        label.category{
            position:relative;
            width:100%;
            background: #ccced1;
            
        }

    .ck.ck-content.ck-editor__editable.ck-rounded-corners.ck-editor__editable_inline{
        height:70vh;
    }

    div.ck.ck-powered-by{
        display:none;
    }

    #Content{
        display:none;
    }

    .image-grid {
        display: grid;
        justify-content:center;
        align-items:center;
        align-content:center;
        grid-template-columns: repeat(auto-fill, minmax(127px, 1fr));
        grid-template-rows:repeat(auto-fit,minmax(127px,1fr));
        /* Adjust the minmax width as needed */
        
        /* Adjust the gap between tiles */
    }

    .image-tile {
        position: relative;
        overflow: hidden;
        /* border: 2px solid transparent; */
        
        height:127px;
        padding:10px;
        
        /* Add transparent border by default */
    }

    .image-tile img {
        width: 100%;
        height:100%;
        object-fit:cover;
     }

     .image-tile.selected {
            
            box-shadow:inset 0 0 0 3px #fff,inset 0 0 0 7px #2271b1;
            /* Add a border color for selected images */
     }

    .image-radio {
        display:none;
    }
</style>
<h2>نوشته جدید</h2>

<form asp-action="CreatePost" method="post" enctype="multipart/form-data" id="createpost-form">
    <div class="row">
    <div class="col-md-9">
        <div class="form-group mb-5">
            <label asp-for="Title" class="pb-2">عنوان</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group mb-5">
                <label asp-for="Content" class="pb-2">متن</label>
                <textarea id="Content" asp-for="Content" id="Content" class="ckeditor " name="Content"></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>
        <div class="form-group mb-5">
                <label asp-for="Excerpt" class="form-label" class="form-control">خلاصه</label>
                <textarea asp-for="Excerpt" name="Excerpt" class="form-control"> </textarea>
        </div>
    </div>
    <div class="col-md-3 mt-4">
        <div id="publish" class="border rounded">
            <label class="rounded-top p-2">انتشار</label>
            <div class="p-3 d-flex flex-column gap-2">
                    <label>
                        <span>
                            نویسنده:
                        </span>
                        @Model.CurrentUser?.UserName
                    </label>
                    <label>
                        <span>
                            تاریخ انتشار:
                        </span>
                        @((Model.CreatedDate == null) ? "--/--/--" : Model.CreatedDate)
                    </label>
                    <label>
                        <span>
                            تاریخ آخرین به روز رسانی:
                        </span>
                        @((Model.UpdateDate == null) ? "--/--/--" : Model.UpdateDate)
                    </label>
                    <button type="submit" class="btn btn-primary">انتشار</button>
            </div>
            
        </div>
            
            <div class="col mt-2 border rounded ">
                <label class="category rounded-top p-2">دسته بندی</label>
                <div class="form-group p-3">
                    <input asp-for="SelectedCategoryIds" type="radio" value="" /> دسته بندی نشده
                    <br />
                    @foreach (var category in @Model.AvailableCategories)
                    {
                        <input asp-for="SelectedCategoryIds" type="radio" value="@category.Value" id="@category.Value" />
                        <label asp-for="SelectedCategoryIds" for="@category.Value">@category.Text</label>
                        <br />
                    }
                </div>
        </div>
        <div class="col">
            <div class="featur-image-box border rounded mt-2 d-flex flex-column">
            <!--Modal Button-->
                <label class="rounded-top p-2">تصویر شاخص</label>
                    <img src="~/Images/default.png" alt="" id="feature-image" class="p-1" />
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#myModal">
                    انتخاب تصویر شاخص
                </button>
                
                <div class="form-group mb-5 d-none">
                    
                    <input type="hidden" asp-for="FeatureImageId" id="selected-image-id" name="FeatureImageId" />
                    <span asp-validation-for="FeatureImageId" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>
    </div>
</form>
<!-- Bootstrap 5 Modal -->
<div class="modal fade" id="myModal">
    <div class="modal-dialog modal-fullscreen p-4">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">

                <h5 class="modal-title">تصویر شاخص</h5>
                <button type="button" class="btn-close m-0" data-bs-dismiss="modal" aria-label="Close"></button>

            </div>
            
            <!-- Modal Body with Tabs -->
            <div class="modal-body">
                <!-- Nav tabs -->
                <ul class="nav nav-tabs" id="myTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active" id="tab1-tab" data-bs-toggle="tab" href="#tab1" role="tab" aria-controls="tab1" aria-selected="true">انتخاب از کتابخانه تصاویر</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" id="tab2-tab" data-bs-toggle="tab" href="#tab2" role="tab" aria-controls="tab2" aria-selected="false">بارگذاری تصویر جدید</a>
                    </li>
                </ul>
                <!-- Tab panes -->
                <div class="tab-content pt-4" id="tab">
                    <div class="tab-pane fade show active" id="tab1" role="tabpanel" aria-labelledby="tab1-tab">
                        <!-- Content for Tab 1 with scrollable container -->
                        <div class="container overflow-auto m-0" id="my-container">
                            <div class="row">
                                <div class="col-md-9 col-" id="gallery-wrapper">
                                    <div class="image-grid">
                                        <!-- Add images here dynamically with radio buttons -->
                                        @if(Model.Images != null)
                                        @foreach (var img in Model.Images)
                                        {
                                            <label class="image-tile" data-image-id="@img.Id">
                                                <input type="radio" name="selected-image" class="image-radio" id="image-radio-@img.Id" value="@img.Id">
                                                <img src="@img.ImageUrl" alt="@img.AltText? @img.AltText: '1' " class="modal-image">
                                            </label>
                                        }

                                    </div>
                                </div>
                                <div class="col-md-3 d-none d-sm-block" id="modal-sidebar">
                                    <p>Display image ditails</p>
                                    <form id="image-details-form">
                                        <div class="mb-3">
                                            <label for="image-title" class="form-label">Title</label>
                                            <input type="text" class="form-control" id="image-title" name="imageTitle">
                                        </div>
                                        <div class="mb-3">
                                            <label for="image-description" class="form-label">Description</label>
                                            <textarea class="form-control" id="image-description" name="imageDescription"></textarea>
                                        </div>
                                        <!-- Add more fields for image details as needed -->
                                        <!-- Save button to save changes -->
                                        <button type="button" id="save-image-details" class="btn btn-success">Save</button>
                                    </form>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="tab-pane fade" id="tab2" role="tabpanel" aria-labelledby="tab2-tab">
                        <!-- Content for Tab 2 with scrollable container -->
                        <div class="container overflow-auto">
                            <div class="row">
                                <div class="col">

                                    <!-- Form for uploading image in second tab-->
                                    <form id="image-upload-form" enctype="multipart/form-data">
                                        <div class="mb-3">
                                            <label for="image-title" class="form-label">Title</label>
                                            <input type="text" class="form-control" id="image-title" name="imageTitle">
                                        </div>
                                        <div class="mb-3">
                                            <label for="image-description" class="form-label">Description</label>
                                            <textarea class="form-control" id="image-description" name="imageDescription"></textarea>
                                        </div>
                                        <div class="mb-3">
                                            <label for="image-file" class="form-label">Select Image:</label>
                                            <input type="file" class="form-control" id="image-file" name="imageFile">
                                        </div>
                                        <button type="submit" class="btn btn-primary">Upload</button>
                                    </form>

                                    
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="modal-cancel">انصراف</button>
                <button type="button" class="btn btn-primary" id="approve" data-bs-dismiss="modal">قرار دادن به عنوان تصویر شاخص</button>
            </div>
        </div>
    </div>
</div>



<script src="https://cdn.ckeditor.com/ckeditor5/39.0.2/classic/ckeditor.js"></script>
<script src="https://cdn.ckeditor.com/ckeditor5/39.0.2/classic/translations/fa.js"></script>

<!--
    CkEditor Script to show it against textarea
-->
<script>
    ClassicEditor
        .create(document.querySelector('#Content'), {
            language:'fa',
            height:'800px'
        })
        .catch(error => {
            console.error(error);
        });
</script>

<!--
     // JavaScript to handle modal image selection
-->
<script src="~/js/MyJs.js"></script>
