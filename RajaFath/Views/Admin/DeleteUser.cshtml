@model RajaFath.Models.EditUserViewModel
@{
    ViewData["Title"] = "DeleteUser";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}

<h2>
    حذف کاربر
</h2>

<p>آیا برای حذف کاربر اطمینان دارید؟</p>
<p><strong>نام کاربری:</strong> @Model.UserName</p>
<p><strong>ایمیل:</strong> @Model.Email</p>

<form asp-action="DeleteUserConfirmed" asp-route-id="@Model.UserId" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">حذف</button>
    <a asp-action="ListUsers" class="btn btn-secondary">انصراف</a>
</form>
