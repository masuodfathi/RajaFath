@model RajaFath.Models.PostList
@{
    ViewData["Title"] = "PostList";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
    int totalPages = (int)Math.Ceiling(Model.TotalPosts / (double)Model.PageSize);
}

<p>
    @if (ViewBag.slug?.ToString() == "page")
    {
        <h1>
            برگه ها
        </h1>
        <a asp-action="CreatePost" asp-route-postType="page">
            برگه جدید
        </a>
    }
    else
    {
        <h1>
           نوشته‌ها
        </h1>
        <a asp-action="CreatePost" asp-route-postType="post">
            ایجاد نوشته
        </a>
    }
    
</p>
<div class="table-container table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Posts[0].Title)</th>
                <th>@Html.DisplayNameFor(model => model.Posts[0].Excerpt)</th>
                <th>نوع</th>
                <th>@Html.DisplayNameFor(model => model.Posts[0].AuthorName)</th>
                <th>@Html.DisplayNameFor(model => model.Posts[0].UpdateDate)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Posts)
            {
                <tr>
                    <td>@Html.DisplayFor(model => item.Title)
                        <div>
                            <a asp-action="CreatePost" asp-route-id="@item.Id" asp-route-postType="@item.PostType">Edit</a>
                            <a asp-action="DeletePost" asp-route-id="@item.Id" asp-route-postType="@item.PostType">Delete</a>
                        </div>
                    </td>
                    <td>@Html.DisplayFor(model => item.Excerpt)</td>
                    <td>@(item.PostType == "page" ? "برگه" : "نوشته")</td>
                    <td>@Html.DisplayFor(model => item.AuthorName)</td>
                    <td>@Html.DisplayFor(model => item.UpdateDate)</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<nav aria-label="Page navigation example">
    <ul class="pagination justify-content-center">
        @if (Model.PageNumber > 1)
        {
            <li class="page-item"><a class="page-link" href="?postType=@(Model.PostType)&page=@(Model.PageNumber - 1)">قبلی</a></li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link" aria-disabled="true">قبلی</span></li>
        }

        @for (int pageNumber = 1; pageNumber <= totalPages; pageNumber++)
        {
            <li class="page-item @(pageNumber == Model.PageNumber ? "active" : "")">
                <a class="page-link" href="?postType=@(Model.PostType)&page=@pageNumber">@pageNumber</a>
            </li>
        }

        @if (Model.PageNumber < totalPages)
        {
            <li class="page-item"><a class="page-link" href="?postType=@(Model.PostType)&page=@(Model.PageNumber + 1)">بعدی</a></li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link" aria-disabled="true">بعدی</span></li>
        }
    </ul>
</nav>
